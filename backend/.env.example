# ============================================
#   BRO-BOT — Environment Configuration
#   Copy this file to .env and fill values
# ============================================

# ---- AI Brain (Google Gemini) ----
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Telegram Bot ----
# Create bot: Talk to @BotFather on Telegram
# Send /newbot, get the token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Your personal Telegram chat ID
# Send /start to your bot, then visit:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ---- LinkedIn (Optional - Phase 3) ----
LINKEDIN_EMAIL=your_linkedin_email
LINKEDIN_PASSWORD=your_linkedin_password

# ---- Instagram (Optional - Phase 2) ----
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# ---- Twitter/X (Optional - Phase 2) ----
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# ---- Server Config ----
PORT=8000
HOST=0.0.0.0

# ---- Your Profile Info ----
YOUR_NAME=Your Name
YOUR_DOMAIN=Full Stack Developer
YOUR_SKILLS=Python, React, Node.js
DAILY_BRIEF_TIME=08:00
